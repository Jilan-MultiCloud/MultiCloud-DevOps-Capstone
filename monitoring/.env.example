AWS_FUNCTION_URL=https://REPLACE.lambda-url.ap-south-1.on.aws
AWS_REGION=ap-south-1
AWS_PROFILE=default
AZURE_SERVICE_URL=https://REPLACE.azurecontainerapps.io
GCP_SERVICE_URL=https://REPLACE.a.run.app
ENABLE_SIMULATION=false
HTTP_TIMEOUT=4
PROBE_INTERVAL=30
# Absolute host path containing a dedicated, temporary, least-privilege AWS profile.
AWS_CREDENTIALS_DIR=C:/Users/REPLACE/.aws
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
